# Required only for real LLM forecasts:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional current-evidence search (Tavily Search API):
TAVILY_API_KEY=

# Choose and preregister this deadline before discovery/enrollment:
STUDY_DEADLINE=

# Optional cost cap controls. Values are estimates, not provider quotes.
MAX_DAILY_SPEND_USD=
ESTIMATED_INPUT_USD_PER_MILLION_TOKENS=
ESTIMATED_OUTPUT_USD_PER_MILLION_TOKENS=
